# SHEM Backend — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to source control.

# ── EMQX Cloud MQTT Broker ────────────────────────────────────
MQTT_HOST=xf061010.ala.asia-southeast1.emqxsl.com
MQTT_PORT=8883
MQTT_USERNAME=shem_backend
MQTT_PASSWORD=
# CA certificate downloaded from the EMQX Cloud deployment page
MQTT_CA_CERT_PATH=./certs/emqxsl-ca.crt
# Optional: paste raw PEM certificate content directly (convenient for cloud/Railway env vars)
# MQTT_CA_CERT_CONTENT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── Device ────────────────────────────────────────────────────
DEVICE_ID=001

# ── Database (Local SQLite or Turso libSQL Cloud) ─────────────
# Local development default:
SQLITE_PATH=./shem.db

# ── Hosting with an ephemeral disk (Render free): SQLite + Litestream ──
# The Docker image stores the DB at /app/data/shem.db and, when LITESTREAM_BUCKET
# is set, restores it on start and streams every change (~1 s) to S3-compatible
# storage (Backblaze B2 / Cloudflare R2 / AWS S3). Leave TURSO_* empty then.
# LITESTREAM_BUCKET=shem-backup
# LITESTREAM_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# LITESTREAM_REGION=us-east-005
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
# LITESTREAM_PATH=shem.db

# Turso Cloud DB (optional alternative; leave empty to use SQLite above):
# Create in Turso: turso db create shem-db && turso db show --url shem-db && turso db tokens create shem-db
# TURSO_DATABASE_URL=libsql://shem-db-[your-username].turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ── API Security ──────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# If empty, every protected endpoint returns 401 (fail-closed).
API_KEY=
ALLOW_UNAUTHENTICATED_DEV=false
# Use CF-Connecting-IP / X-Forwarded-For for per-client rate limits behind the tunnel
TRUST_PROXY_HEADERS=true
# Set false to hide /docs, /redoc and /openapi.json on the public tunnel
EXPOSE_DOCS=true

# ── Rate limits ───────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RELAY_COMMAND=10/minute
RATE_LIMIT_HISTORY=30/minute
RATE_LIMIT_BILLS_CREATE=20/minute

# ── Command & staleness ───────────────────────────────────────
COMMAND_EXPIRY_SECONDS=30
STALE_TELEMETRY_THRESHOLD_SECONDS=10
# Active power above this counts as "load active" (separate from relay state)
LOAD_ACTIVE_THRESHOLD_W=5

# ── Data retention / condensing ───────────────────────────────
# Raw ~2 s readings are kept this many days; older data lives on as
# hourly rollups (telemetry_hourly), kept indefinitely.
RAW_TELEMETRY_RETENTION_DAYS=7
EVENT_RETENTION_DAYS=90
MAINTENANCE_INTERVAL_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=5

# ── Locale (day/week/month boundaries, hour-of-day buckets) ───
TIMEZONE=Asia/Kolkata

# ── CORS (comma-separated; add your tunnel origin) ────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Tariff (₹/kWh) — default only; household_config overrides ─
DEFAULT_TARIFF_RATE_INR_PER_KWH=7.5

# ── Server ────────────────────────────────────────────────────
# 0.0.0.0 for Docker/Railway containers, or 127.0.0.1 for local only
HOST=0.0.0.0
PORT=8000
DEV_RELOAD=false

# ── File Uploads (Bill document storage) ──────────────────────
# Bill documents are stored in the database (Turso), so no disk/volume is needed.
# UPLOADS_DIR is only read for documents uploaded by older versions.
UPLOADS_DIR=./uploads
MAX_BILL_DOCUMENT_MB=10.0

# ── Relay load mismatch detection ─────────────────────────────
RELAY_MISMATCH_ENABLED=true
# Default % deviation from rated watts (also adjustable in the Settings UI)
RELAY_MISMATCH_THRESHOLD_PERCENT=30.0
RELAY_MISMATCH_MIN_WATTS=5.0
# Live watts >= rated * factor shows a hard warning if user claims it is the same appliance
RELAY_MISMATCH_BIG_DIFF_FACTOR=5.0
RELAY_MISMATCH_COOLDOWN_MINUTES=60

# ── SHEM AI (energy guide) ────────────────────────────────────
# Both providers are called with the OpenAI SDK (OpenAI-compatible APIs).
# The primary is tried first; the other is the automatic fallback.
# Leave a key empty to disable that provider.
AI_ENABLED=true
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# Multiple keys: comma-separated. Each key is tried round-robin with per-key back-off on rate limits.
# GEMINI_API_KEYS=key1,key2,key3
# GROQ_API_KEYS=key1,key2
# Groq production models with tool use: openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b
AI_TEMPERATURE=0.4
AI_MAX_TOOL_ROUNDS=8
# Conflict scan cadence and the local hour after which yesterday's briefing is generated
AI_BACKGROUND_ENABLED=true
AI_CONFLICT_SCAN_INTERVAL_SECONDS=60
AI_DAILY_INSIGHT_HOUR=7
RATE_LIMIT_AI_CHAT=20/minute

# ── SHEM AI Live voice (Sarvam: Saaras STT + Bulbul TTS) ──────
# https://dashboard.sarvam.ai — the key stays on the backend.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
# auto = detect the spoken language; or force e.g. en-IN, hi-IN, te-IN, ta-IN
SARVAM_STT_LANGUAGE=auto
SARVAM_STT_SILENCE_MS=600
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_PACE=1.05
# Spoken when the detected language has no Bulbul voice
SARVAM_TTS_DEFAULT_LANGUAGE=en-IN
# User speaking stops the AI's audio
AI_VOICE_BARGE_IN=true

# ── Frontend (optional) — serve the built React app from this backend ──
FRONTEND_DIST_PATH=../frontend/dist

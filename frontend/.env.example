# SHEM frontend — copy to .env.local (never commit real keys)

# Backend base URL. Leave EMPTY to use same-origin requests:
#   - `npm run dev` proxies /api to SHEM_BACKEND_URL (below)
#   - production: the backend serves the built app (FRONTEND_DIST_PATH)
VITE_API_BASE_URL=

# Optional build-time API key. Prefer entering it in Settings → Backend
# connection instead: anything here is embedded in the JavaScript bundle.
VITE_API_KEY=

# Where the dev/preview proxy sends /api (not exposed to the browser)
SHEM_BACKEND_URL=http://127.0.0.1:8000

# Optional HTTPS for phones on the LAN (PWA install + microphone need a secure
# context). Generate with mkcert, e.g.: mkcert 192.168.1.20 localhost
SHEM_HTTPS_CERT=
SHEM_HTTPS_KEY=
